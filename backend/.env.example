# ============================================
# Smart Financial Research MAS - Configuration
# ============================================

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# LLM Parameters
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# Database
DATABASE_PATH=data/research_db.sqlite

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Reports
REPORTS_DIR=reports




































































































